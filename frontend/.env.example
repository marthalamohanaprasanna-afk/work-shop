# ===================================================
# GEMINI CHATBOT - FRONTEND CONFIGURATION (.env)
# ===================================================

# 1. Supabase Public Project Configuration
# Get from: Supabase Dashboard -> Project Settings -> API (URL & anon public key)
# NOTE: The "anon" key is designed for public client-side browser use.
# NEVER put your "service_role" key in the frontend!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# 2. Backend API Endpoint
BACKEND_URL=http://localhost:5000
VITE_BACKEND_URL=http://localhost:5000

# 3. Application Preferences
DEFAULT_MODEL=gemini-2.5-flash
APP_TITLE=Gemini AI Chatbot
