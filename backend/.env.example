# ===================================================
# GEMINI CHATBOT - BACKEND CONFIGURATION (.env)
# ===================================================

# 1. Google Gemini LLM API Key (Required)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Server Configuration
PORT=5000
DEFAULT_MODEL=gemini-2.5-flash

# 3. Supabase REST & Auth Configuration
# Get from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 4. Supabase Direct PostgreSQL Connection (Required for: npm run db:migrate)
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.[your-project-id]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres
